ENVIRONMENT=development
DATABASE_URL=sqlite:///./worldcup-v2.db
# Set a private random key before submitting mutations; production requires >=24 characters.
ADMIN_API_KEY=
ALLOW_DEMO_DATA=false
ALLOWED_ORIGINS=
COMPUTE_TIMEOUT_SECONDS=120
# MODEL_BUNDLE_DIR=models/verified-v2
# LLM is optional. Configure an OpenAI-compatible endpoint to enable the coordinator.
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_MAX_DAILY_CALLS=200
API_FOOTBALL=
API_FOOTBALL_MAX_DAILY_CALLS=100
BACKEND_URL=http://localhost:8001
# Combined free deployment: dashboard starts its own loopback-only API.
COMBINED_SERVICE=false
# Server-side credential: must equal ADMIN_API_KEY; never sent to the browser.
BACKEND_API_KEY=
# Restore API-Football -> factual feed -> prediction on startup/hourly.
AUTO_REFRESH_DATA=true
DATA_REFRESH_INTERVAL_SECONDS=3600
